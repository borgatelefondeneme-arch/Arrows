{
  "name": "ok-kup",
  "version": "1.0.0",
  "description": "Ok Küp – küp ve prizmalar üzerindeki okları temizleyip tatlı karakteri kurtardığın 3D bulmaca oyunu (iPhone uyumlu web oyunu + VS sunucusu).",
  "type": "module",
  "private": true,
  "main": "server/index.js",
  "scripts": {
