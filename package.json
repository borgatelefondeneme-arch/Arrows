  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.1.0",
    "three": "^0.180.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
